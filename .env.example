# ===================================================================
# ResearchMind Configuration Template
# Copy this file to .env and insert your personal API keys.
# ===================================================================

# Google Gemini API Key (Required for Writer & Critic agents)
# Get a key at: https://aistudio.google.com
GOOGLE_API_KEY="your-google-api-key-here"

# Tavily Search API Key (Required for live Search Agent research)
# Get a free key at: https://tavily.com
TAVILY_API_KEY="your-tavily-api-key-here"

# Optional: Groq API Key (For ultra-fast LPU inference)
# Get a free key at: https://console.groq.com
GROQ_API_KEY=""

# Optional: Hugging Face Access Token
# Get a free token at: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_ACCESS_TOKEN=""
